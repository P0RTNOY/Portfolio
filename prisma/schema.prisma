generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id                  String   @id @default(cuid()) @db.Text
  title               String   @db.Text
  slug                String   @unique @db.Text
  shortDescription    String   @map("short_description") @db.Text
  fullDescription     String   @default("") @map("full_description") @db.Text
  techStack           String   @default("[]") @map("tech_stack") @db.Text
  githubUrl           String?  @map("github_url") @db.Text
  liveUrl             String?  @map("live_url") @db.Text
  imageUrl            String?  @map("image_url") @db.Text
  screenshots         String   @default("[]") @db.Text
  status              String   @default("planned") @db.Text
  featured            Boolean  @default(false)
  role                String?  @db.Text
  highlights          String   @default("[]") @db.Text
  problemSolved       String?  @map("problem_solved") @db.Text
  technicalChallenges String?  @map("technical_challenges") @db.Text
  displayOrder        Int      @default(0) @map("display_order")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([featured, displayOrder])
  @@index([status])
  @@index([createdAt])
  @@map("projects")
}

model Course {
  id               String   @id @default(cuid()) @db.Text
  title            String   @db.Text
  slug             String   @unique @db.Text
  provider         String   @default("Udemy") @db.Text
  courseUrl        String   @map("course_url") @db.Text
  imageUrl         String?  @map("image_url") @db.Text
  shortDescription String   @map("short_description") @db.Text
  fullDescription  String   @default("") @map("full_description") @db.Text
  skills           String   @default("[]") @db.Text
  instructor       String?  @db.Text
  status           String   @default("planned") @db.Text
  progress         Int      @default(0)
  certificateUrl   String?  @map("certificate_url") @db.Text
  credentialUrl    String?  @map("credential_url") @db.Text
  startedAt        DateTime? @map("started_at") @db.Date
  completedAt      DateTime? @map("completed_at") @db.Date
  featured         Boolean  @default(false)
  displayOrder     Int      @default(0) @map("display_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([featured, displayOrder])
  @@index([status])
  @@index([createdAt])
  @@map("courses")
}

model SiteSettings {
  id                String   @id @default("default") @db.Text
  siteName          String   @default("Omer Portnoy") @map("site_name") @db.Text
  heroEyebrow       String   @default("Software Engineer · AI / Full-Stack / Automation") @map("hero_eyebrow") @db.Text
  heroTitle         String   @default("I build practical AI-powered software, full-stack products, and automation tools.") @map("hero_title") @db.Text
  heroIntro         String   @default("I'm Omer Portnoy, a software engineering graduate focused on building real working products - from backend systems and admin dashboards to LLM-powered apps, developer tools, and automation workflows.") @map("hero_intro") @db.Text
  primaryCtaLabel   String   @default("Explore the platform") @map("primary_cta_label") @db.Text
  secondaryCtaLabel String   @default("Contact me") @map("secondary_cta_label") @db.Text
  aboutTitle        String   @default("Software engineer with a builder mindset.") @map("about_title") @db.Text
  aboutSummary      String   @default("I'm a software engineering graduate who likes building practical systems end-to-end: the frontend people use, the backend that powers it, the database that keeps it reliable, and the tooling that makes it easier to maintain. My current focus is AI-powered products, automation, backend/full-stack development, and learning how to ship software that feels useful, not just technically impressive.") @map("about_summary") @db.Text
  skillsTitle       String   @default("Technical focus areas.") @map("skills_title") @db.Text
  skillsSummary     String   @default("The areas I'm actively building and improving across product engineering, backend systems, AI applications, cloud workflows, and software fundamentals.") @map("skills_summary") @db.Text
  skills            String   @default("[\"Python\",\"TypeScript\",\"React\",\"Next.js\",\"Node.js\",\"FastAPI\",\"Supabase\",\"PostgreSQL\",\"Prisma\",\"Docker\",\"GCP\",\"REST APIs\",\"AI Integrations\",\"LLM Apps\",\"Hugging Face\",\"OpenAI\",\"Automation\",\"CI/CD\",\"Data Structures\",\"Security Fundamentals\"]") @db.Text
  contactTitle      String   @default("Let's build something useful.") @map("contact_title") @db.Text
  contactSummary    String   @default("I'm looking for software engineering opportunities where I can contribute, learn fast, and build real products with strong technical foundations.") @map("contact_summary") @db.Text
  contactEmail      String   @default("omerportnoy@gmail.com") @map("contact_email") @db.Text
  githubUrl         String?  @map("github_url") @db.Text
  linkedinUrl       String?  @map("linkedin_url") @db.Text
  resumeUrl         String?  @map("resume_url") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}
